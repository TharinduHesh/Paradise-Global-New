# D1 is accessed through the Cloudflare Pages Function at /api/contact.
# Configure the DB binding in wrangler.toml or the Cloudflare Pages dashboard.

# Secrets are never committed. For local `npm run dev:pages`, copy the lines below into `.dev.vars` (git-ignored).
# In production, add them as encrypted secrets: Pages project → Settings → Variables and Secrets.
# ADMIN_EMAIL and FROM_EMAIL are plain variables in wrangler.toml.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=
OWNER_SETUP_TOKEN=
